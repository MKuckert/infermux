{
  "name": "infermux",
  "version": "0.1.0",
  "description": "OpenAI-compatible API proxy with single-concurrency queueing and dynamic local inference engine lifecycles",
  "keywords": [
    "openai",
    "proxy",
    "llm",
    "vllm",
    "ollama",
    "lmstudio",
    "inference",
    "gpu"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "config.schema.json"
  ],
  "type": "module",
  "engines": {
    "node": ">=18.17",
    "bun": ">=1.1"
  },
  "bin": {
    "infermux": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"import('node:fs').then(fs=>fs.chmodSync('dist/cli.js', 0o755))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "start:bun": "bun dist/cli.js",
    "dev": "tsx src/cli.ts",
    "dev:bun": "bun src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "ajv": "^8.20.0",
    "hono": "^4.6.14",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
